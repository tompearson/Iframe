# Copy to .env (gitignored). Values must match documentation-helper for local dev.

# Upstream RAG (local or Render)
RAG_API_URL=http://127.0.0.1:8000
# RAG_API_URL=https://santoshapilates-rag.onrender.com

# Server-side only — same as documentation-helper RAG_SERVICE_SECRET
RAG_SERVICE_SECRET=

# Local dev server bind
# EMBED_DEV_HOST=127.0.0.1
# EMBED_DEV_PORT=8780

# Optional turn limits (dev_server / Vercel BFF)
# EMBED_MAX_TURNS_PER_SESSION=20
# EMBED_MAX_TURNS_PER_IP=60
# EMBED_MAX_QUERY_LENGTH=1000
