{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://www.santoshapilates.com https://santoshapilates.com http://127.0.0.1:* http://localhost:*"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/embed", "destination": "/embed/index.html" },
    { "source": "/demo", "destination": "/demo/parent.html" }
  ]
}
